# ==========================================
# Microservices Root Environment Variables
# ==========================================

NODE_ENV=development

# API Gateway Configuration
GATEWAY_PORT=3000
GATEWAY_CORS_ORIGIN=*

# User Service Configuration
USER_SERVICE_PORT=3001
USER_SERVICE_URL=http://user-service:3001
USER_DB_HOST=user-db
USER_DB_PORT=5432
USER_DB_NAME=user_service_db
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres_user_secret
USER_DATABASE_URL=postgresql://postgres:postgres_user_secret@user-db:5432/user_service_db?schema=public

# Notification Service Configuration
NOTIFICATION_SERVICE_PORT=3002
NOTIFICATION_SERVICE_URL=http://notification-service:3002
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_service_db
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASSWORD=postgres_notification_secret
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres_notification_secret@notification-db:5432/notification_service_db?schema=public

# NATS JetStream Configuration
NATS_URL=nats://nats:4222
NATS_USER=app_user
NATS_PASSWORD=app_secret_pass

# Security & JWT
JWT_SECRET=super-secure-jwt-secret-replace-in-production-at-least-32-chars-long
JWT_EXPIRES_IN=24h
INTERNAL_API_KEY=internal-service-secret-key-replace-in-production
